{
  "name": "lucky-stack-v2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "LuckyStack — socket-first React 19 + Node fullstack framework. This repo is the framework monorepo plus a sample project; published packages live in packages/*.",
  "license": "MIT",
  "author": "Mathijs van Melick <mathijsvanmelick3@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ItsLucky23/LuckyStack-v2.git"
  },
  "homepage": "https://github.com/ItsLucky23/LuckyStack-v2#readme",
  "bugs": {
    "url": "https://github.com/ItsLucky23/LuckyStack-v2/issues"
  },
  "engines": {
    "node": ">=22.13.0",
    "bun": ">=1.3.3"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "ai:index": "node scripts/generateAiIndex.mjs",
    "ai:capabilities": "node scripts/generateAiCapabilities.mjs",
    "ai:project-index": "node scripts/generateProjectIndex.mjs",
    "ai:decisions": "node scripts/generateDecisionsIndex.mjs",
    "ai:product": "node scripts/generateProductOverview.mjs",
    "ai:graph": "node scripts/generateGraph.mjs",
    "ai:lint": "node scripts/lintInvariants.mjs",
    "ai:doc-staleness": "node scripts/checkDocStaleness.mjs",
    "ai:lessons": "node scripts/generateLessonsIndex.mjs",
    "ai:eval": "node eval/scoreEval.mjs",
    "test": "tsx --tsconfig tsconfig.server.json scripts/testAll.ts",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "verify:orm-wire": "tsx --tsconfig tsconfig.server.json scripts/verifyOrmWireProjection.ts",
    "smoke:ws": "tsx --tsconfig tsconfig.server.json scripts/wsProxySmoke.ts",
    "benchmark:runtime": "node scripts/benchmarkRuntime.mjs",
    "benchmark:concurrency": "node scripts/benchmarkConcurrency.mjs",
    "benchmark:http": "node scripts/benchmark/runHttp.mjs",
    "scaffold:test": "node scripts/scaffoldRouteTest.mjs",
    "scaffold:page": "node scripts/scaffoldPage.mjs",
    "client": "vite --host 0.0.0.0",
    "client:port": "vite --host 0.0.0.0 --port",
    "server": "npx tsx --tsconfig tsconfig.server.json server/dev/supervisor.ts",
    "server:direct": "npx tsx --tsconfig tsconfig.server.json server/server.ts",
    "router": "npx tsx --tsconfig tsconfig.server.json scripts/router.ts",
    "cluster": "npx tsx --tsconfig tsconfig.server.json scripts/cluster.ts",
    "lint": "node scripts/withThreads.mjs --mb-per-thread 2048 --max-threads 3 eslint \"src/**/*.{ts,tsx}\" \"server/**/*.ts\" \"shared/**/*.ts\" \"config.ts\" \"packages/*/src/**/*.ts\" --cache --cache-location .eslintcache --ignore-pattern \"**/*.generated.*\" --ignore-pattern \"server/prod/generatedApis.ts\" --ignore-pattern \"server/prod/generatedApis.*.ts\" --ignore-pattern \"packages/**/*.test.ts\" --ignore-pattern \"packages/devkit/src/templates/page_*.template.ts\" --concurrency {threads}",
    "lint:client": "eslint \"src/**/*.{ts,tsx}\" --cache --cache-location .eslintcache --ignore-pattern \"**/*.generated.*\"",
    "lint:server": "eslint \"server/**/*.ts\" \"shared/**/*.ts\" \"config.ts\" --cache --cache-location .eslintcache --ignore-pattern \"**/*.generated.*\" --ignore-pattern \"server/prod/generatedApis.ts\" --ignore-pattern \"server/prod/generatedApis.*.ts\"",
    "lint:all": "npm run lint",
    "lint:packages": "eslint \"packages/*/src/**/*.ts\" --cache --cache-location .eslintcache --ignore-pattern \"**/*.generated.*\" --ignore-pattern \"**/*.test.ts\" --ignore-pattern \"packages/devkit/src/templates/page_*.template.ts\"",
    "generateArtifacts": "node scripts/runParallel.mjs \"tsx --tsconfig tsconfig.server.json scripts/generateTypeMaps.ts\" \"tsx --tsconfig tsconfig.server.json scripts/generateServerRequests.ts\"",
    "typecheck": "node node_modules/@typescript/native/bin/tsc -b",
    "buildClient": "tsx --tsconfig tsconfig.server.json scripts/generateTypeMaps.ts && node scripts/runParallel.mjs \"npm run typecheck\" \"vite build\"",
    "buildServer": "npm run generateArtifacts && node scripts/bundleServer.mjs",
    "build": "npm run build:packages && npm run generateArtifacts && node scripts/runParallel.mjs \"2:npm run typecheck\" \"vite build && node scripts/bundleServer.mjs\"",
    "verify": "npm run build:packages && npm run generateArtifacts && node scripts/runParallel.mjs \"2:npm run lint\" \"npm run typecheck\" \"vite build && node scripts/bundleServer.mjs\" \"8:vitest run\"",
    "build:packages": "node scripts/buildPackages.mjs",
    "bump": "node scripts/bumpVersion.mjs",
    "pack:dry": "node scripts/buildPackages.mjs --pack-dry-run",
    "publish:dry": "node scripts/publishPackages.mjs --dry-run",
    "publish:packages": "node scripts/publishPackages.mjs",
    "prod": "node dist/server.js",
    "bun:check": "node scripts/checkBunCompat.mjs",
    "bun:server": "bun --bun server/server.ts",
    "bun:prod": "bun --bun dist/server.js",
    "prisma:generate": "tsx --tsconfig tsconfig.server.json scripts/prismaWithSecrets.ts generate",
    "prisma:db:push": "tsx --tsconfig tsconfig.server.json scripts/prismaWithSecrets.ts db push",
    "help": "node scripts/help.mjs",
    "ai:refresh": "node scripts/aiRefresh.mjs",
    "ai:check-ids": "node scripts/checkRecordIds.mjs",
    "postinstall": "node -e \"try{require('fs').statSync('src/_sockets/apiTypes.generated.ts')}catch{require('child_process').execSync('npm run generateArtifacts',{stdio:'inherit'})}\" && node scripts/aiRefresh.mjs --if-missing",
    "prepare": "node -e \"try{require('child_process').execSync('git config core.hooksPath .githooks',{stdio:'ignore'})}catch{}\"",
    "ai:changelog-check": "node scripts/checkChangelogs.mjs",
    "audit:production": "node scripts/auditProduction.mjs",
    "e2e:verdaccio": "node scripts/e2eVerdaccio.mjs"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-brands-svg-icons": "^7.2.0",
    "@fortawesome/free-regular-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.3.0",
    "@prisma/client": "^6.19.3",
    "@sentry/node": "^10.66.0",
    "@sentry/react": "^10.66.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "bcryptjs": "^3.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.0.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.0.0",
    "motion": "^12.40.0",
    "node-pty": "^1.1.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.18.2",
    "resend": "^6.0.0",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.7",
    "uuid": "^14.0.0",
    "validator": "^13.15.35",
    "vconsole": "^3.15.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.2",
    "@emnapi/runtime": "^1.11.2",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-alias": "^6.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/validator": "^13.15.10",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.0",
    "chokidar": "^5.0.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.12.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-react-x": "^5.27.1",
    "eslint-plugin-unicorn": "^78.0.0",
    "globals": "^17.13.0",
    "postcss": "^8.5.23",
    "prettier": "^3.9.10",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.2.2",
    "tsup": "^8.5.0",
    "tsx": "^4.23.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.4"
  },
  "overrides": {
    "@eslint/eslintrc@<3.3.6": "3.3.6",
    "@hono/node-server@<1.19.15": "1.19.15",
    "body-parser@>=2.0.0 <2.2.3": "2.3.0",
    "brace-expansion@<1.1.18": "1.1.18",
    "esbuild": "0.28.1",
    "fast-uri@>=3.0.0 <3.1.5": "3.1.5",
    "hono@>=4.0.0 <4.12.34": "4.12.34",
    "ip-address@<=10.3.0": "10.5.0",
    "js-yaml@>=4.0.0 <4.3.1": "4.3.1",
    "nanoid@<3.3.18": "3.3.18",
    "socket.io-parser@>=4.0.0 <4.2.7": "4.2.7",
    "ws": "^8.21.0"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "core-js@3.49.0": true,
    "esbuild@0.28.1": true,
    "node-pty@1.1.0": true,
    "prisma@6.19.3": true,
    "unrs-resolver@1.12.2": true
  }
}
