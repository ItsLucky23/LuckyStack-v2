#!/bin/sh
#? Two pure-Node CHECKS. Nothing else.
#?
#? This hook used to run ten generators and `git add` their output. Two things
#? were wrong with that. It made every commit slow — and it made the commit
#? UNTRUE: the generators read the whole working tree, not the staging area, so
#? a commit could carry an index derived from code that wasn't in it.
#?
#? The AI-context artifacts are now gitignored (see .gitignore) and rebuilt by
#? `npm run ai:refresh` / `postinstall`. With nothing committed there is nothing
#? to keep in sync, so this hook writes NOTHING to the working tree.
#?
#? Active via `git config core.hooksPath .githooks` (set by the root `prepare`
#? script at install time).

set -e

if ! command -v node >/dev/null 2>&1; then
  echo "[pre-commit] node not on PATH — skipping AI checks."
  exit 0
fi

#? Blocking: a duplicate/dangling ADR or lesson number is an identity collision.
#? Left alone it gets "fixed" by renumbering, and every reference written under
#? the old scheme then points at a real but WRONG record. ~125ms.
echo "[pre-commit] Checking record-id identity (ADRs + lessons)..."
node scripts/checkRecordIds.mjs

#? Report-only by default; individual rules opt into blocking via
#? luckystack.invariants.json.
echo "[pre-commit] Checking CLAUDE.md invariants on staged changes..."
node scripts/lintInvariants.mjs

#? Nudges, never blocking.
echo "[pre-commit] Checking hand-written doc staleness (report-only)..."
node scripts/checkDocStaleness.mjs || true

echo "[pre-commit] Checking CHANGELOG completeness (report-only)..."
node scripts/checkChangelogs.mjs || true
